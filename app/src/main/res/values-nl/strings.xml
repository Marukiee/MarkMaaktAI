    <string name="onboarding_welcome_title">MarkMaaktAI</string>
    <string name="onboarding_welcome_body">Een lokale AI-hub. Chatten, je scherm laten lezen, foto\'s bekijken en je berichten onder controle houden, allemaal op deze telefoon.</string>
    <string name="onboarding_privacy_title">Er gaat niets de deur uit</string>
    <string name="onboarding_privacy_body">Het model draait op je eigen hardware. Alleen webzoeken en downloads gebruiken het netwerk, en die zet je zelf uit.</string>
    <string name="onboarding_notifications_title">Je meldingen lezen</string>
    <string name="onboarding_notifications_body">Geef toegang tot meldingen zodat korte reeksen berichten een rustige samenvatting worden.</string>
    <string name="onboarding_battery_title">Blijf draaien op de achtergrond</string>
    <string name="onboarding_battery_body">Android is streng voor achtergrond-apps, en het ene toestel meer dan het andere. Batterijoptimalisatie uitzetten houdt de meldingenlezer aan.</string>
    <string name="onboarding_assistant_title">Vervang de assistent</string>
    <string name="onboarding_assistant_body">Stel MarkMaaktAI in als standaardassistent om het met de aan-uitknop of een hoekveeg te openen.</string>
    <string name="onboarding_model_title">Kies een model</string>
    <string name="onboarding_model_body">Kies een bestand dat je al hebt, of download er een via wifi.</string>
