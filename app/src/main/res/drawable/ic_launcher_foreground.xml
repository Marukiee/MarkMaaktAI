<?xml version="1.0" encoding="utf-8"?>
<!--
  One capsule, tilted to -45 degrees, centred inside the adaptive icon safe zone.
  The fill points at the Android 12+ system palette, so the launcher icon picks up
  the same wallpaper colours as the Material You theme inside the app.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-45">
        <path
            android:fillColor="@color/ic_launcher_pill"
            android:pathData="M36,41 L72,41 A13,13 0 0 1 72,67 L36,67 A13,13 0 0 1 36,41 Z" />
    </group>
</vector>
