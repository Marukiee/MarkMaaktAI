    <!-- Onboarding -->
    <string name="onboarding_welcome_title">MarkMaaktAI</string>
    <string name="onboarding_welcome_body">A local AI hub. Chat, read your screen, look at photos and keep your messages under control, all on this phone.</string>
    <string name="onboarding_privacy_title">Nothing leaves the phone</string>
    <string name="onboarding_privacy_body">The model runs on your own hardware. Only web search and downloads use the network, and both are yours to switch off.</string>
    <string name="onboarding_notifications_title">Read your notifications</string>
    <string name="onboarding_notifications_body">Grant notification access so short bursts of messages can be turned into one calm summary.</string>
    <string name="onboarding_battery_title">Stay alive in the background</string>
    <string name="onboarding_battery_body">Sony Xperia and GrapheneOS are strict about background apps. Turning off battery optimisation keeps the reader running.</string>
    <string name="onboarding_assistant_title">Replace the assistant</string>
    <string name="onboarding_assistant_body">Set MarkMaaktAI as your default assistant to open it with the power button or the corner swipe.</string>
    <string name="onboarding_model_title">Pick a model</string>
    <string name="onboarding_model_body">Choose a file you already have, or download one over Wi-Fi.</string>
