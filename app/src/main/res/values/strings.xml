    <!-- Help tips -->
    <string name="settings_retention">Keep notifications for</string>
    <string name="settings_retention_value">%1$d days</string>
    <string name="help_pure_black">On an OLED screen a black pixel is switched off, so this saves power. Cards stay a shade lighter so the layout does not go flat.</string>
    <string name="help_temperature">Low keeps answers predictable, high lets the model wander. Around 0.7 suits most things.</string>
    <string name="help_max_tokens">The ceiling on how long an answer may get. Longer answers take longer to write and use more memory.</string>
    <string name="help_gpu">Faster on a Snapdragon 8 Gen 3 or a Tensor G4. Turn it off if answers come out garbled or the app closes on you.</string>
    <string name="help_battery">Android may stop the notification reader to save power. This exempts it, which is what keeps the feature working on Sony and GrapheneOS.</string>
    <string name="help_assistant">Opens the system screen for picking a default assistant. Choose MarkMaaktAI there to reach it with the power button.</string>
    <string name="help_min_words">Short replies like ok or thanks are never worth a summary, so anything under this many words is ignored.</string>
    <string name="help_cluster_size">A summary is only written once this many messages arrive close together, which is what keeps the model from running on every single message.</string>
    <string name="help_urgent">Only summaries the model flagged as urgent are allowed to make a sound. Everything else lands silently.</string>
    <string name="help_retention">Stored notifications older than this are deleted. They are only kept so you can ask about them later.</string>
